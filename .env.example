# Expo 앱 환경 변수. cp .env.example .env 후 값을 채운다.
# EXPO_PUBLIC_ 로 시작하는 값은 앱 안에 그대로 들어가므로 "공개돼도 되는 값"만 넣는다.
# (카카오 Client Secret, JWT 비밀 키 같은 것은 절대 넣지 말 것 — 서버 .env 에만)

# 백엔드 주소. 실제 폰에서는 localhost 가 폰 자신이므로 PC 의 IP 를 쓴다. 예: http://192.168.0.10:4000/api
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:4000/api

# 카카오 REST API 키 (인가 코드 요청 주소에 들어가는 공개 값)
EXPO_PUBLIC_KAKAO_REST_API_KEY=
# 카카오 콘솔과 서버 KAKAO_REDIRECT_URIS 에 똑같이 등록한 주소
EXPO_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:5173/oauth/kakao

# 개발용 로그인 버튼 표시 (서버도 DEV_LOGIN_ENABLED=true 여야 동작)
EXPO_PUBLIC_DEV_LOGIN=false

# 목업 모드: true 면 백엔드 없이 가짜 데이터로 모든 화면을 볼 수 있다 (src/shared/api/mockServer.js)
# 로그인 화면의 "개발용 로그인" 버튼으로 들어간다
EXPO_PUBLIC_MOCK_API=false
